      "type": "dial",
      "id": "dial",
      "cycle": "hour",
      "radius": 150,
      "ticks": {
        "major": 12,
        "minor": 60
      },
      "labels": {
        "count": 12,
        "format": "minutes"
      },
      "hand": {
        "length": 140,
        "width": 2,
        "color": "theme.accent"
      },
      "subdials": [
        {
          "cycle": "half-day",
          "radius": 34,
          "offset": [
            0,
            52
          ],
          "labels": 12,
          "hand": {
            "length": 26,
            "width": 1.5,
            "color": "theme.text"
          }
        }
      ]
    }
  ],
  "states": {
