{
  "recipe": 1,
  "id": "analog",
  "name": "analog stopwatch",
  "icon": "analog",
  "measure": {
    "unit": "time",
    "perMinute": 1
  },
  "environment": {
    "type": "theme"
  },
  "cycles": [
    {
      "id": "hour",
      "minutes": 60
    },
    {
      "id": "half-day",
      "minutes": 720
