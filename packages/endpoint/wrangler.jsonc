// The Worker and its bindings (not deployed yet; see README.md).
{
  "name": "stopwatch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Static files: the built site, with its _headers. The Worker runs only for /api/.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "COUNTS",
      "database_name": "stopwatch-counts",
      // Filled in when the database is created, at the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // No request logs: the endpoint keeps nothing about a request (plan, Privacy).
  "observability": { "enabled": false },
  // The site lives on its own domain (an open decision: the product name), not on workers.dev.
  "workers_dev": false,
  "preview_urls": false
}
