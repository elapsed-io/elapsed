// The Worker and its bindings (deployed by the owner; see docs/deploy.md and docs/test-run.md).
{
  "name": "elapsed",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Static files: the built site, with its _headers. The Worker runs only for /api/.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elapsed",
      // Filled in when the database is created, at the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Daily, deletes crash reports older than 14 days (src/crash.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  // No request logs: the endpoint keeps nothing about a request (plan, Privacy).
  "observability": { "enabled": false },
  // The site will live on its own domain (elapsed.io, attached at launch), never on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // The private test run (docs/test-run.md): its own Worker on a workers.dev address, behind
    // Cloudflare Access, with its own database, so nothing it counts mixes with the real site's.
    // Deploy with `npm run deploy:test`; the production settings above are unchanged.
    "test": {
      "name": "elapsed-test",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "elapsed-test",
          // Filled in when the test database is created (docs/deploy.md, part 2, step 2).
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["17 4 * * *"] }
    }
  }
}
